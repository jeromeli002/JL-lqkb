{
    "keyboard_name": "测试",
    "manufacturer": "JLKB",
    "url": "http://jlkb.jlkb.top",
    "maintainer": "JLKB",
    "processor": "STM32F401",
    "board": "BLACKPILL_STM32_F401",
    "bootloader": "stm32-dfu",
    "usb": {
        "vid": "0xF005",
        "pid": "0x3001",
        "device_version": "0.0.1"
    },

    "rgblight": {
        "saturation_steps": 8,/* 饱和度步数 */
        "brightness_steps": 8,/* 亮度步数 */
        "led_count": 4, /* 灯数量 */
        "hue_steps":8,/* 色调步数 */
        "max_brightness":250,/* 最大亮度 */
        "sleep": true,/* 睡眠时关闭灯 */
        /* "led_map": [4, 3, 2, 1, 0], LE灯D顺序 */
        "animations": {/* 灯效 */
            "static_light": true,
            "breathing": true,
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "snake": true,
            "knight": true,
            "christmas": true,
            "static_gradient": true,
            "rgb_test": true,
            "alternating": true,
            "twinkle": true
        }
    },
    "ws2812": {
        "pin": "A13"
    },
    "matrix_pins": {
        "cols": ["B3", "C12", "C11"],
        "rows": ["B5", "B4"]
    },
    "diode_direction": "COL2ROW",

    "layouts": {
        "LAYOUT": {
            "layout": [
{"matrix":[0,0],"x":0,"y":0},
{"matrix":[0,1],"x":1,"y":0},
{"matrix":[0,2],"x":2,"y":0},

{"matrix":[1,0],"x":0,"y":1},
{"matrix":[1,1],"x":1,"y":1},
{"matrix":[1,2],"x":2,"y":1},

			]
        }
    }
}