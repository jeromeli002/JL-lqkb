{
    "keyboard_name": "测试",
    "manufacturer": "JLKB",
    "url": "https://jlkb.jlkb.top",
    "maintainer": "JLKB",
    "processor": "STM32F103",
    "board": "STM32_F103_STM32DUINO",
    "bootloader": "vibl",
    "usb": {
        "vid": "0xBB00",
        "pid": "0xBB00",
        "device_version": "0.0.1"
    },
    
    "rgblight": {
        "saturation_steps": 8,/* 饱和度步数 */
        "brightness_steps": 8,/* 亮度步数 */
        "led_count": 28, /* 灯数量 */
        "hue_steps":8,/* 色调步数 */
        "max_brightness":250,/* 最大亮度 */
        "sleep": true,/* 睡眠时关闭灯 */
        /* "led_map": [4, 3, 2, 1, 0], LE灯D顺序 */
        "animations": {/* 灯效 */
            "static_light": true,
            "breathing": true,
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "snake": true,
            "knight": true,
            "christmas": true,
            "static_gradient": true,
            "rgb_test": true,
            "alternating": true,
            "twinkle": true
        }
    },
     "ws2812": {
        "pin": "A0"
    },
    "matrix_pins": {
        "cols": ["C13", "C14", "C15", null, null],
        "rows": ["B9", "B8", null, null, null]
    },
    "diode_direction": "COL2ROW",

    "layouts": {
        "LAYOUT": {
            "layout": [
            { "matrix": [0, 0],"x": 0,"y": 0}, 
            { "matrix": [0, 1],"x": 1,"y": 0},
            { "matrix": [0, 2],"x": 2,"y": 0}, 
            { "matrix": [0, 3],"x": 3,"y": 0}, 
            { "matrix": [0, 4],"x": 4,"y": 0},
             
            { "matrix": [1, 0],"x": 0,"y": 1}, 
            { "matrix": [1, 1],"x": 1,"y": 1}, 
            { "matrix": [1, 2],"x": 2,"y": 1}, 
            { "matrix": [1, 3],"x": 3,"y": 1}, 
            { "matrix": [1, 4],"x": 4,"y": 1}, 
            
            { "matrix": [2, 0],"x": 0,"y": 2}, 
            { "matrix": [2, 1],"x": 1,"y": 2}, 
            { "matrix": [2, 2],"x": 2,"y": 2}, 
            { "matrix": [2, 3],"x": 3,"y": 2}, 
            { "matrix": [2, 4],"x": 4,"y": 2}, 
            
            { "matrix": [3, 0],"x": 0,"y": 3}, 
            { "matrix": [3, 1],"x": 1,"y": 3}, 
            { "matrix": [3, 2],"x": 2,"y": 3}, 
            { "matrix": [3, 3],"x": 3,"y": 3}, 
            { "matrix": [3, 4],"x": 4,"y": 3},
             
            { "matrix": [4, 0],"x": 0,"y": 4}, 
            { "matrix": [4, 1],"x": 1,"y": 4}, 
            { "matrix": [4, 2],"x": 2,"y": 4}, 
            { "matrix": [4, 3],"x": 3,"y": 4}, 
            { "matrix": [4, 4],"x": 4,"y": 4}
			]
        }
    }
}