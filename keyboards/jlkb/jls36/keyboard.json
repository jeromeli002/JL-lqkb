{
    "keyboard_name": "分体36",
    "manufacturer": "JLKB",
    "url": "http://jlkb.jlkb.top",
    "maintainer": "JLKB",
    "processor": "STM32F401",
    "board": "BLACKPILL_STM32_F401",
    "bootloader": "stm32-dfu",
    "usb": {
        "vid": "0xF005",
        "pid": "0x3001",
        "device_version": "0.0.1"
    },
    "features": {
        "encoder": true,
        "split": true,
        "nkro": true,
        "rgb_matrix": true
    },
    "matrix_pins": {
        "cols": ["B12", "B13", "B14", "C6", "C7"],
        "rows": ["A15", "C10", "C11", "A5"]
    },
    "diode_direction": "COL2ROW",
    "split": {
        "enabled": true,
        "transport": {
            "sync": {
                "indicators": true,
                "layer_state": true,
                "matrix_state": true,
                "oled": true,
                "modifiers": true,
                "wpm": true
            }
        },
        "serial": {
            "driver": "usart",
            "pin": "A9"
        }
    },
    "rgblight": {
        "saturation_steps": 8,  // 饱和度步数
        "brightness_steps": 8,  // 亮度步数
        "led_count": 36,       // 灯数量 
        "hue_steps":8,          // 色调调节步数 
        "max_brightness":250,   // 最大亮度 
        "sleep": true,          // 键盘睡眠时是否关闭灯光
    },
    "rgb_matrix": {
        "animations": {
            "alphas_mods": true,                  //Alpha修正
            "breathing": true,                    //呼吸模式
            "band_sat": true,                     //色带饱和度★
            "band_val": true,                     //色带亮度★
            "band_pinwheel_sat": true,            //色带风车饱和度★
            "band_pinwheel_val": true,            //色带风车亮度★
            "band_spiral_sat": true,              //色带螺旋饱和度★
            "band_spiral_val": true,              //色带螺旋亮度★
            "cycle_all": true,                    //循环所有
            "cycle_left_right": true,             //左右循环
            "cycle_up_down": true,                //上下循环
            "cycle_out_in": true,                 //由外向内循环
            "cycle_out_in_dual": true,            //双向由外向内循环
            "cycle_pinwheel": true,               //风车循环
            "cycle_spiral": true,                 //风车循环
            "digital_rain": true,                 //数字雨
            "dual_beacon": true,                  //双信标
            "flower_blooming": true,              // 花朵绽放  
            "gradient_up_down": true,             //上下渐变
            "gradient_left_right": true,          //左右渐变
            "hue_breathing": true,                //色调呼吸
            "hue_pendulum": true,                 //色调摆动
            "hue_wave": true,                     //色调波浪
            "jellybean_raindrops": true,          //糖豆雨滴
            "multisplash": true,                  //多重飞溅★
            "pixel_rain": true,                   //像素雨
            "pixel_flow": true,                   //像素流
            "pixel_fractal": true,                //像素分形
            "rainbow_beacon": true,               //双信标
            "rainbow_pinwheels": true,            //彩虹风车
            "raindrops": true,                    //雨滴
            "rainbow_moving_chevron": true,       //彩虹移动V形
            "riverflow": true,                    // 河流
            "solid_reactive_simple": true,        //简单纯色反应
            "solid_reactive": true,               //纯色反应
            "solid_reactive_wide": true,          //宽纯色反应
            "solid_reactive_multiwide": true,     //多宽纯色反应
            "solid_reactive_cross": true,         //交叉纯色反应
            "solid_reactive_multicross": true,    //多交叉纯色反应
            "solid_reactive_nexus": true,         //枢纽纯色反应
            "solid_reactive_multinexus": true,    //多枢纽纯色反应
            "solid_splash": true,                 //纯色飞溅
            "solid_multisplash": true,            //纯色多重飞溅
            "splash": true,                       //飞溅
            "starlight": true,                    // 星光
            "starlight_dual_hue": true,           // 星光双色调
            "starlight_dual_sat": true,           // 星光双饱和度
            "typing_heatmap": true,               //打字热力图
            "vialrgb_direct": true
        },
