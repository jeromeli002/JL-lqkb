{
    "keyboard_name": "F区-滚轮",
    "manufacturer": "JLKB",
    "url": "http://wpa.qq.com/msgrd?v=3&uin=532192607&site=qq&menu=yes",
    "maintainer": "JLKB",
    "processor": "STM32F072",
    "bootloader": "stm32-dfu",
    "usb": {
        "vid": "0xF002",
        "pid": "0x3001",
        "device_version": "0.0.1"
    },
     "features": {
        "rgb_matrix": true
    },
    "encoder": {
    "rotary": [
      { "pin_a": "B8", "pin_b": "B9", "resolution": 4 },
      { "pin_a": "A2", "pin_b": "A1", "resolution": 4 }
    ]
  }
    "matrix_pins": {
        "rows": ["A3", "A4", "A5" ],
        "cols": ["C13", "C14", "C15", "B7", "B6" ]
    },
    "rgblight": {
        "saturation_steps": 8,/* 饱和度步数 */
        "brightness_steps": 8,/* 亮度步数 */
        "led_count": 12, /* 灯数量 */
        "hue_steps":8,/* 色调步数 */
        "max_brightness":250,/* 最大亮度 */
        "sleep": true,/* 睡眠时关闭灯 */
        /* "led_map": [4, 3, 2, 1, 0], LE灯D顺序 */
    },
    "rgb_matrix": {
        "animations": {
            "band_pinwheel_sat": true,            //色带风车饱和度★
            "band_spiral_sat": true,              //色带螺旋饱和度★
            "band_spiral_val": true,              //色带螺旋亮度★
            "cycle_all": true,                    //循环所有
            "cycle_out_in": true,                 //由外向内循环
            "cycle_out_in_dual": true,            //双向由外向内循环
            "cycle_spiral": true,                 //风车循环
            "hue_breathing": true,                //色调呼吸
            "hue_wave": true,                     //色调波浪
            "multisplash": true,                  //多重飞溅★
            "pixel_rain": true,                   //像素雨
            "pixel_flow": true,                   //像素流
            "rainbow_beacon": true,               //双信标
            "rainbow_pinwheels": true,            //彩虹风车
            "raindrops": true,                    //雨滴
            "rainbow_moving_chevron": true,       //彩虹移动V形
            "riverflow": true,                    // 河流
            "solid_splash": true,                 //纯色飞溅
            "starlight": true,                    // 星光
            "starlight_dual_hue": true,           // 星光双色调
            "starlight_dual_sat": true,           // 星光双饱和度
            "typing_heatmap": true,               //打字热力图
            "vialrgb_direct": true               //打字热力图
        },
    "layout": [ 
        {"matrix":[2,1],"x":224,"y":0,"flags":4},
		{"matrix":[2,0],"x":204,"y":0,"flags":4},
		
		{"matrix":[1,4],"x":183,"y":0,"flags":4},
		{"matrix":[1,3],"x":163,"y":0,"flags":4},
		{"matrix":[1,2],"x":143,"y":0,"flags":4},
		{"matrix":[1,1],"x":122,"y":0,"flags":4},
		{"matrix":[1,0],"x":102,"y":0,"flags":4},
		
		{"matrix":[0,4],"x":81,"y":0,"flags":4},
		{"matrix":[0,3],"x":61,"y":0,"flags":4},
		{"matrix":[0,2],"x":41,"y":0,"flags":4},
		{"matrix":[0,1],"x":20,"y":0,"flags":4},
		{"matrix":[0,0],"x":0,"y":0,"flags":4}
    ],
        "driver": "ws2812",
        "center_point": [ 112, 0],
        "react_on_keyup": true
    },
    "ws2812": {
        "pin": "B5"
    },
    "diode_direction": "COL2ROW",
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3, "y": 0},
                {"matrix": [0, 4], "x": 4, "y": 0},

                {"matrix": [1, 0], "x": 0.25, "y": 1},
                {"matrix": [1, 1], "x": 1.25, "y": 1},
                {"matrix": [1, 2], "x": 2.25, "y": 1},
                {"matrix": [1, 3], "x": 3.25, "y": 1},
                {"matrix": [1, 4], "x": 4.25, "y": 1},

                {"matrix": [2, 0], "x": 0.5, "y": 2},
                {"matrix": [2, 1], "x": 1.5, "y": 2},
                {"matrix": [2, 2], "x": 2.5, "y": 2},
                {"matrix": [2, 3], "x": 3.5, "y": 2},
                {"matrix": [2, 4], "x": 4.5, "y": 2}
            ]
        }
    }
}