{
    "keyboard_name": "摇杆",
    "manufacturer": "JLKB",
    "url": "https://jlkb.jlkb.top",
    "maintainer": "JLKB",
    "processor": "STM32F103",
    "board": "STM32_F103_STM32DUINO",
    "bootloader": "custom",
    "usb": {
        "vid": "0xF001",
        "pid": "0x5009",
        "device_version": "0.0.1"
    },
    "features": {
        "rgb_matrix": true
    },
    "matrix_pins": {
        "cols": ["A6", "A7", null ],
        "rows": ["A5", "B10", null ]
    },
    "rgblight": {
        "saturation_steps": 8,/* 饱和度步数 */
        "brightness_steps": 8,/* 亮度步数 */
        "led_count": 1, /* 灯数量 */
        "hue_steps":8,/* 色调步数 */
        "max_brightness":250,/* 最大亮度 */
        "sleep": true,/* 睡眠时关闭灯 */
        /* "led_map": [4, 3, 2, 1, 0], LE灯D顺序 */
    },
    "rgb_matrix": {
        "animations": {
            "cycle_all": true,                    //循环所有
            "cycle_out_in": true,                 //由外向内循环
            "cycle_out_in_dual": true,            //双向由外向内循环
            "cycle_spiral": true,                 //风车循环
            "hue_breathing": true,                //色调呼吸
            "hue_wave": true,                     //色调波浪
            "multisplash": true,                  //多重飞溅★
            "pixel_rain": true,                   //像素雨
            "pixel_flow": true,                   //像素流
            "rainbow_beacon": true,               //双信标
            "rainbow_pinwheels": true,            //彩虹风车
            "raindrops": true,                    //雨滴
            "rainbow_moving_chevron": true,       //彩虹移动V形
            "riverflow": true,                    // 河流
            "starlight": true,                    // 星光
            "starlight_dual_hue": true,           // 星光双色调
            "starlight_dual_sat": true,           // 星光双饱和度
            "typing_heatmap": true,               //打字热力图
            "vialrgb_direct": true               //打字热力图
        },
    "layout": [ 
		{"matrix":[0,0],"x":0,"y":0,"flags":4}
    ],
        "driver": "ws2812",
        "center_point": [ 112, 0],
        "react_on_keyup": true
    },
    "ws2812": {
        "pin": "A4"
    },
    "diode_direction": "COL2ROW",
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},

                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},

                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2}             
                
            ]
        }
    }
}
