{
    "keyboard_name": "左手键盘",
    "manufacturer": "JLKB",
    "url": "http://jlkb.jlkb.top",
    "maintainer": "JLKB",
    "processor": "STM32F401",
    "board": "BLACKPILL_STM32_F401",
    "bootloader": "stm32-dfu",
    "usb": {
        "vid": "0xF005",
        "pid": "0x3001",
        "device_version": "0.0.1"
    },
    "encoder": {
    "rotary": [
      { "pin_a": "A13", "pin_b": "A14", "resolution": 4 },
      { "pin_a": "C3", "pin_b": "C5", "resolution": 4 },
      { "pin_a": "C1", "pin_b": "C2", "resolution": 4 }
    ]
  }
  
    "rgblight": {
        "saturation_steps": 8,/* 饱和度步数 */
        "brightness_steps": 8,/* 亮度步数 */
        "led_count": 104, /* 灯数量 */
        "hue_steps":8,/* 色调步数 */
        "max_brightness":180,/* 最大亮度 */
        "sleep": true,/* 睡眠时关闭灯 */
        /* "led_map": [4, 3, 2, 1, 0], LE灯D顺序 */
        "animations": {/* 灯效 */
            "static_light": true,
            "breathing": true,
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "snake": true,
            "knight": true,
            "christmas": true,
            "static_gradient": true,
            "rgb_test": true,
            "alternating": true,
            "twinkle": true
        }
    },
    
     "ws2812": {
        "pin": "C6"
    },
    "matrix_pins": {
        "cols": ["A4", "A3", "A2", "A0", "C15", "C14", "C13", "B2", "B3", "B4", "B5"],
        "rows": ["B14", "B10", "B1", "B0", "B9", "A8", "A7", "A6", "A5", "B8"]
