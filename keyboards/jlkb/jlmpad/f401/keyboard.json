{
    "keyboard_name": "JL-MPad",
    "manufacturer": "JLKB",
    "url": "http://wpa.qq.com/msgrd?v=3&uin=532192607&site=qq&menu=yes",
    "maintainer": "JLKB",
    "processor": "STM32F401",
    "board": "BLACKPILL_STM32_F401",
    "bootloader": "stm32-dfu",
    "usb": {
        "vid": "0xF006",
        "pid": "0x5001",
        "device_version": "0.0.1"
    },
     "features": {
        "rgb_matrix": true
    },
    "encoder": {
    "rotary": [
      { "pin_a": "A1", "pin_b": "A2", "resolution": 4 }
    ]
  }
  
    "rgblight": {
        "saturation_steps": 8,  // 饱和度步数
        "brightness_steps": 8,  // 亮度步数
        "led_count": 19,        //灯数量
        "hue_steps":8,          // 色调步数 
        "max_brightness":215,   // 最大亮度 
        "sleep": true,          // 睡眠时关闭灯 
    },
    "rgb_matrix": {
        "animations": {
            "alphas_mods": true,
            "gradient_up_down": true,
            "gradient_left_right": true,
            "breathing": true,
            "band_sat": true,
            "band_val": true,
            "band_pinwheel_sat": true,
            "band_pinwheel_val": true,
            "band_spiral_sat": true,
            "band_spiral_val": true,
            "cycle_all": true,
            "cycle_left_right": true,
            "cycle_up_down": true,
            "rainbow_moving_chevron": true,
            "cycle_out_in": true,
            "cycle_out_in_dual": true,
            "cycle_pinwheel": true,
            "cycle_spiral": true,
            "dual_beacon": true,
            "rainbow_beacon": true,
            "rainbow_pinwheels": true,
            "raindrops": true,
            "jellybean_raindrops": true,
            "hue_breathing": true,
            "hue_pendulum": true,
            "hue_wave": true,
            "pixel_rain": true,
            "pixel_flow": true,
            "pixel_fractal": true,
            "typing_heatmap": true,
            "digital_rain": true,
            "solid_reactive_simple": true,
            "solid_reactive": true,
            "solid_reactive_wide": true,
            "solid_reactive_multiwide": true,
            "solid_reactive_cross": true,
            "solid_reactive_multicross": true,
            "solid_reactive_nexus": true,
            "solid_reactive_multinexus": true,
            "splash": true,
            "multisplash": true,
            "solid_splash": true,
            "solid_multisplash": true
        },
    "layout": [ 
        {"matrix": [1, 0], "x": 10, "y": 0, "flags": 4},
        {"matrix": [1, 1], "x": 20, "y": 0, "flags": 4},
        
        {"matrix": [1, 2], "x": 0, "y": 10, "flags": 4},
        {"matrix": [1, 3], "x": 10, "y": 10, "flags": 4},
        {"matrix": [2, 0], "x": 20, "y": 10, "flags": 4},
        {"matrix": [2, 1], "x": 30, "y": 10, "flags": 4},
        
        {"matrix": [2, 2], "x": 0, "y": 20, "flags": 4},
        {"matrix": [2, 3], "x": 10, "y": 20, "flags": 4},
        {"matrix": [2, 4], "x": 20, "y": 20, "flags": 4},
        {"matrix": [3, 0], "x": 30, "y": 25, "flags": 4},
        
        {"matrix": [3, 1], "x": 0, "y": 30, "flags": 4},
        {"matrix": [3, 2], "x": 10, "y": 30, "flags": 4},
        {"matrix": [3, 3], "x": 20, "y": 30, "flags": 4},
        
        {"matrix": [3, 4], "x": 0, "y": 40, "flags": 4},
        {"matrix": [4, 0], "x": 10, "y": 40, "flags": 4},
        {"matrix": [4, 1], "x": 20, "y": 40, "flags": 4},
        {"matrix": [4, 2], "x": 30, "y": 45, "flags": 4},
        
        {"matrix": [4, 3], "x": 15, "y": 50, "flags": 4},
        {"matrix": [4, 4], "x": 20, "y": 50, "flags": 4}
    ],
        "led_count": 19,        //灯数量
        "driver": "ws2812",
        "center_point": [ 15, 25],
        "react_on_keyup": true
    },
    "ws2812": {
        "pin": "B9"
    },
    
    "matrix_pins": {
      "cols": ["A3", "A0", "C15", "C14", "C13"  ],
      "rows": ["B8", "B7", "B6", "B3", "B4",null ]
      "io_delay": 5    //延迟
    },
    
    "diode_direction": "COL2ROW",
