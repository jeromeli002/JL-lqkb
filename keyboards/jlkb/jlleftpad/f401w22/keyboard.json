{
    "keyboard_name": "左手镜像Pad",
    "manufacturer": "JLKB",
    "url": "http://jlkb.jlkb.top",
    "maintainer": "JLKB",
    "processor": "STM32F401",
    "board": "BLACKPILL_STM32_F401",
    "bootloader": "stm32-dfu",
    "usb": {
        "vid": "0xF005",
        "pid": "0x3001",
        "device_version": "0.0.1"
    },
    "features": {
        "bluetooth": true,
        "rgb_matrix": true
    },
    "encoder": {
    "rotary": [
      { "pin_a": "A8", "pin_b": "C9", "resolution": 4 }
    ]
  },
    "bluetooth":{
        "driver":"bhq"
    },
    "build": {
        "debounce_type": "sym_defer_pk",
        "lto": true
    },
    "debounce": 10,
  "rgblight": {
        "saturation_steps": 8,  // 饱和度步数
        "brightness_steps": 8,  // 亮度步数
        "led_count": 17,       // 灯数量 
        "hue_steps":8,          // 色调调节步数 
        "max_brightness":250,   // 最大亮度 
        "sleep": true,          // 键盘睡眠时是否关闭灯光
    },
    "rgb_matrix": {
        "animations": {
            "alphas_mods": true,                  //Alpha修正
            "breathing": true,                    //呼吸模式
            "band_sat": true,                     //色带饱和度★
            "band_val": true,                     //色带亮度★
            "band_pinwheel_sat": true,            //色带风车饱和度★
            "band_pinwheel_val": true,            //色带风车亮度★
            "band_spiral_sat": true,              //色带螺旋饱和度★
            "band_spiral_val": true,              //色带螺旋亮度★
            "cycle_all": true,                    //循环所有
            "cycle_left_right": true,             //左右循环
            "cycle_up_down": true,                //上下循环
            "cycle_out_in": true,                 //由外向内循环
            "cycle_out_in_dual": true,            //双向由外向内循环
            "cycle_pinwheel": true,               //风车循环
            "cycle_spiral": true,                 //风车循环
            "digital_rain": true,                 //数字雨
            "dual_beacon": true,                  //双信标
            "flower_blooming": true,              // 花朵绽放  
            "gradient_up_down": true,             //上下渐变
            "gradient_left_right": true,          //左右渐变
            "hue_breathing": true,                //色调呼吸
            "hue_pendulum": true,                 //色调摆动
            "hue_wave": true,                     //色调波浪
            "jellybean_raindrops": true,          //糖豆雨滴
            "multisplash": true,                  //多重飞溅★
            "pixel_rain": true,                   //像素雨
            "pixel_flow": true,                   //像素流
            "pixel_fractal": true,                //像素分形
            "rainbow_beacon": true,               //双信标
            "rainbow_pinwheels": true,            //彩虹风车
            "raindrops": true,                    //雨滴
            "rainbow_moving_chevron": true,       //彩虹移动V形
            "riverflow": true,                    // 河流
            "solid_reactive_simple": true,        //简单纯色反应
            "solid_reactive": true,               //纯色反应
            "solid_reactive_wide": true,          //宽纯色反应
            "solid_reactive_multiwide": true,     //多宽纯色反应
            "solid_reactive_cross": true,         //交叉纯色反应
            "solid_reactive_multicross": true,    //多交叉纯色反应
            "solid_reactive_nexus": true,         //枢纽纯色反应
            "solid_reactive_multinexus": true,    //多枢纽纯色反应
            "solid_splash": true,                 //纯色飞溅
            "solid_multisplash": true,            //纯色多重飞溅
            "splash": true,                       //飞溅
            "starlight": true,                    // 星光
            "starlight_dual_hue": true,           // 星光双色调
            "starlight_dual_sat": true,           // 星光双饱和度
            "typing_heatmap": true,               //打字热力图
            "vialrgb_direct": true
        },
    "layout": [ 
    {"matrix":[0,0],"x":0,"y":0,"flags":4},
    {"matrix":[0,1],"x":75,"y":0,"flags":4},
    {"matrix":[0,2],"x":149,"y":0,"flags":4},
    {"matrix":[0,3],"x":224,"y":0,"flags":4},
    {"matrix":[1,0],"x":0,"y":24,"flags":4},
    {"matrix":[1,1],"x":75,"y":16,"flags":4},
    {"matrix":[1,2],"x":149,"y":16,"flags":4},
    {"matrix":[1,3],"x":224,"y":16,"flags":4},
    {"matrix":[2,1],"x":75,"y":32,"flags":4},
    {"matrix":[2,2],"x":149,"y":32,"flags":4},
    {"matrix":[2,3],"x":224,"y":32,"flags":4},
    {"matrix":[3,0],"x":0,"y":56,"flags":4},
    {"matrix":[3,1],"x":75,"y":48,"flags":4},
    {"matrix":[3,2],"x":149,"y":48,"flags":4},
    {"matrix":[3,3],"x":224,"y":48,"flags":4},
    {"matrix":[4,1],"x":75,"y":64,"flags":4},
    {"matrix":[4,3],"x":187,"y":64,"flags":4}
    ],
        "led_count": 17,           //灯珠数量 (与 rgblight.led_count 相同，可能是冗余或用于不同模块)
        "driver": "ws2812",         //RGB 灯珠驱动类型
        "center_point": [ 149, 32],  //RGB 矩阵的中心点坐标 [X, Y]，用于某些中心发散的灯效
        "react_on_keyup": true      //是否在按键抬起时触发灯效
    },
     "ws2812": {
        "pin": "B1"
    },
    "matrix_pins": {
        "cols": ["A5", "A13", "A14", "A15", null],
        "rows": ["B14", "B15", "B5", "B9", "B8"]
    },
    "diode_direction": "COL2ROW",

    "layouts": {
        "LAYOUT": {
            "layout": [
            { "matrix": [0, 0],"x": 0,"y": 0}, 
            { "matrix": [0, 1],"x": 1,"y": 0},
            { "matrix": [0, 2],"x": 2,"y": 0}, 
            { "matrix": [0, 3],"x": 3,"y": 0}, 
            { "matrix": [0, 4],"x": 4,"y": 0},
             
            { "matrix": [1, 0],"x": 0,"y": 1}, 
            { "matrix": [1, 1],"x": 1,"y": 1}, 
            { "matrix": [1, 2],"x": 2,"y": 1}, 
            { "matrix": [1, 3],"x": 3,"y": 1}, 
            { "matrix": [1, 4],"x": 4,"y": 1}, 
            
            { "matrix": [2, 0],"x": 0,"y": 2}, 
            { "matrix": [2, 1],"x": 1,"y": 2}, 
            { "matrix": [2, 2],"x": 2,"y": 2}, 
            { "matrix": [2, 3],"x": 3,"y": 2}, 
            { "matrix": [2, 4],"x": 4,"y": 2}, 
            
            { "matrix": [3, 0],"x": 0,"y": 3}, 
            { "matrix": [3, 1],"x": 1,"y": 3}, 
            { "matrix": [3, 2],"x": 2,"y": 3}, 
            { "matrix": [3, 3],"x": 3,"y": 3}, 
            { "matrix": [3, 4],"x": 4,"y": 3},
             
            { "matrix": [4, 0],"x": 0,"y": 4}, 
            { "matrix": [4, 1],"x": 1,"y": 4}, 
            { "matrix": [4, 2],"x": 2,"y": 4}, 
            { "matrix": [4, 3],"x": 3,"y": 4}, 
            { "matrix": [4, 4],"x": 4,"y": 4}
			]
        }
    }
}